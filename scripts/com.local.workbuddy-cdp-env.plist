<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  登录时自动为 WorkBuddy 客户端设置 CDP 调试端口环境变量。
  安装：
    cp scripts/com.local.workbuddy-cdp-env.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.local.workbuddy-cdp-env.plist
  验证：
    launchctl getenv WORKBUDDY_REMOTE_DEBUGGING_PORT   # 应输出 9222
  之后每次登录、每次启动客户端都会带调试端口。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.workbuddy-cdp-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>launchctl setenv WORKBUDDY_REMOTE_DEBUGGING_PORT 9222</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
